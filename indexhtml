<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Responsive Web Page</title>
    <link rel="stylesheet" href="styles.css">
</head>
<body>

    <!-- Navigation Bar -->
    <nav>
        <div class="logo">My Website</div>
        <ul class="nav-links">
            <li><a href="#">Home</a></li>
            <li><a href="#">Services</a></li>
            <li><a href="#">About</a></li>
            <li><a href="#">Contact</a></li>
        </ul>
    </nav>

    <!-- Header -->
    <header>
        <h1>Welcome to My Responsive Website</h1>
        <p>This page adjusts to different screen sizes.</p>
    </header>

    <!-- Main Content -->
    <main>
        <section class="content">
            <h2>Main Content</h2>
            <p>
                This is the main content area of the webpage. Resize the browser
                window to see how the layout changes for mobile, tablet, and
                desktop devices.
            </p>
        </section>

        <aside class="sidebar">
            <h2>Sidebar</h2>
            <p>Additional information can be displayed here.</p>
        </aside>
    </main>

    <!-- Footer -->
    <footer>
        <p>&copy; 2026 My Website. All Rights Reserved.</p>
    </footer>

</body>
</html>
